# Copy to backend/.env. Keep DATABASE_URL and JWT_SECRET server-only.
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=4000
WEB_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax

# S3-compatible product image storage. Use a private write credential and a
# public HTTPS CDN/base URL for reading product images; never use a VITE_ prefix.
IMAGE_STORAGE_REGION=us-east-1
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_STORAGE_PUBLIC_BASE_URL=
# Optional for S3-compatible providers such as R2 or MinIO.
IMAGE_STORAGE_ENDPOINT=
